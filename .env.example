# GraphQL endpoint of the CoreShop installation including the API key (server side only)
API_URL=https://coreshop-enterprise-demo.localhost/pimcore-graphql-webservices/coreshop?apikey=<api key>
# Host of that installation, used for next/image and the public asset base URL (build time)
API_HOSTNAME=coreshop-enterprise-demo.localhost
NEXT_PUBLIC_PIMCORE_BASE_URL=https://coreshop-enterprise-demo.localhost
# Auth.js
AUTH_SECRET=<openssl rand -base64 32>
AUTH_TRUST_HOST=true
# GraphQL codegen (npm run codegen)
CODEGEN_SCHEMA_URL=${API_URL}
